# Keep this key on the server. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional model overrides.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_RESERVE_MODEL=gemini-3.6-flash

# Canonical backend. PostgreSQL is supplied directly by Docker Compose; this
# SQLite value is convenient when running FastAPI outside Compose.
APP_ENV=development
DATABASE_URL=sqlite:///./data/niriksh.db
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
TRACKING_TOKEN_DAYS=180
JWT_SECRET=local-only-change-before-deployment
INTERNAL_API_KEY=local-development-key
DIRECTORY_HASH_SECRET=replace-with-a-separate-random-hmac-secret
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=demo-only-change-me
AUTO_CREATE_TABLES=true
MAX_EVIDENCE_BYTES=10000000

# Local backend/BFF. Replace both with the same random value outside local development.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
BACKEND_INTERNAL_API_KEY=local-development-key
BACKEND_ALLOW_DEMO_PROXY=true
SESSION_COOKIE_SECURE=false
# Local demo convenience only; production ECS never sets this.
DISABLE_OFFICER_AUTH=true

# Evidence storage. Keep local for development; select s3 at deployment.
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=ap-south-1
EVIDENCE_S3_PREFIX=niriksh/evidence
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_FORCE_PATH_STYLE=false
