APP_ENV=development
# Copy this template to the repository root as .env. A backend/.env override is optional.
DATABASE_URL=sqlite:///./data/niriksh.db
FRONTEND_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=local-development-key
BHUMIKA_INTEGRATION_KEY=replace-with-a-separate-random-service-key
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=demo-only-change-me
EVIDENCE_STORAGE_PATH=./data/evidence
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=ap-south-1
EVIDENCE_S3_PREFIX=niriksh/evidence
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_FORCE_PATH_STYLE=false
MAX_EVIDENCE_BYTES=10000000

# Bhumika owns Meta/WhatsApp. Niriksh accepts only curated server submissions.

# Optional connected multimodal analysis. Audio is transcribed and extracted in the same run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_RESERVE_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25
