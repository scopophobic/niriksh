APP_ENV=development
# Copy this template to the repository root as .env. A backend/.env override is optional.
DATABASE_URL=sqlite:///./data/niriksh.db
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
TRACKING_TOKEN_DAYS=180
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=local-development-key
DIRECTORY_HASH_SECRET=replace-with-a-separate-random-hmac-secret
BHUMIKA_INTEGRATION_KEY=replace-with-a-separate-random-service-key
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=demo-only-change-me
EVIDENCE_STORAGE_PATH=./data/evidence
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=ap-south-1
EVIDENCE_S3_PREFIX=niriksh/evidence
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_FORCE_PATH_STYLE=false
MAX_EVIDENCE_BYTES=10000000

# Bhumika owns Meta/WhatsApp. Niriksh accepts only curated server submissions.

# Optional connected multimodal analysis. Audio is transcribed and extracted in the same run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_RESERVE_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# Awareness PSA pipeline (plan-awareness-psa.md). No default — video render is disabled
# until a real fal.ai key is set.
FAL_KEY=
FAL_H3_MODEL=minimax/h3-max-turbo/text-to-video
FAL_H3_REFERENCE_MODEL=minimax/h3-max/reference-to-video

# PSA publish connectors (plan-awareness-psa.md, Phase 3). Each stays inert -- and
# publish_to_configured_channels records "not_configured" for it -- until set.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CATEGORY_ID=27
YOUTUBE_PRIVACY_STATUS=unlisted
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# No WhatsApp entry here on purpose -- see backend/app/modules/awareness/publishers/whatsapp.py.
