# Must exactly match INTERNAL_API_KEY in api.env.
BACKEND_INTERNAL_API_KEY=replace-with-a-random-32-byte-value

# Optional connected analysis used by Next.js analysis and the WhatsApp-style demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_RESERVE_MODEL=gemini-2.5-flash

# Required only once the real WhatsApp channel goes live (docs/bhumika-integration.md).
# Authenticates app/api/internal/whatsapp/turn -- the backend's only path to the actual
# conversation brain (lib/whatsapp-chat-engine.ts). Must exactly match WHATSAPP_INTERNAL_KEY
# in api.env. Never expose this as a NEXT_PUBLIC_ variable.
WHATSAPP_INTERNAL_KEY=
