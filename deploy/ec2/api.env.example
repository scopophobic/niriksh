APP_ENV=production

# Use the Supabase IPv4 session pooler and require TLS. Percent-encode special
# characters in the password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
FRONTEND_ORIGINS=https://demo.example.com
PUBLIC_APP_URL=https://demo.example.com
TRACKING_TOKEN_DAYS=180

# For a fresh database, generate each value independently with:
# openssl rand -hex 32
# When moving an existing deployment, retain JWT_SECRET to preserve signed
# tracking links and DIRECTORY_HASH_SECRET to preserve identifier fingerprints.
JWT_SECRET=replace-with-an-independent-random-value
INTERNAL_API_KEY=replace-with-the-same-value-as-web-env
DIRECTORY_HASH_SECRET=replace-with-an-independent-random-value
# Retain this value or rotate Bhumika to the new value at the same time.
BHUMIKA_INTEGRATION_KEY=replace-with-an-independent-random-value

SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=replace-with-a-strong-demo-password
AUTO_CREATE_TABLES=false
PROCESS_WEBHOOKS_INLINE=true
MAX_EVIDENCE_BYTES=10000000

# Private Supabase Storage S3-compatible bucket. These credentials remain only
# on the server and must never be added to GitHub repository secrets.
EVIDENCE_STORAGE_BACKEND=s3
EVIDENCE_S3_BUCKET=niriksh-bucket
EVIDENCE_S3_REGION=ap-southeast-1
EVIDENCE_S3_PREFIX=niriksh/evidence
EVIDENCE_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_FORCE_PATH_STYLE=true

# Optional. The deterministic fallback remains available when this is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_RESERVE_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25
